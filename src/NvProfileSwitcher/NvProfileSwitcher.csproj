<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NvProfileSwitcher</AssemblyName>
    <DevelopmentBuild Condition="'$(DevelopmentBuild)' == ''">true</DevelopmentBuild>
    <DevelopmentRevision Condition="'$(DevelopmentRevision)' == ''"></DevelopmentRevision>
    <DefineConstants Condition="'$(DevelopmentBuild)' == 'true'">$(DefineConstants);NVPS_DEV_BUILD</DefineConstants>
    <RootNamespace>NvProfileSwitcher</RootNamespace>
    <ApplicationIcon>Assets\branding\NvProfileSwitcher.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- A NativeAOT publish fails on any trimming or AOT warning (IL2xxx, IL3xxx). -->
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/branding/NvProfileSwitcher.ico" />
    <AvaloniaResource Include="Assets/branding/header.png" />
    <AvaloniaResource Include="Assets/icons/brightness.png" />
    <AvaloniaResource Include="Assets/icons/contrast.png" />
    <AvaloniaResource Include="Assets/icons/gamma.png" />
    <AvaloniaResource Include="Assets/icons/vibrance.png" />
    <AvaloniaResource Include="Assets/icons/hue.png" />
    <AvaloniaResource Include="Assets/icons/nvidia.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="StaticLink.Avalonia" Version="3.119.4-7922.1" />
  </ItemGroup>
  <Target Name="GenerateDevelopmentRevisionSource" BeforeTargets="CoreCompile" Condition="'$(DevelopmentBuild)' == 'true'">
  <ItemGroup>
    <_DevelopmentRevisionSource Include="namespace NvProfileSwitcher%3B" />
    <_DevelopmentRevisionSource Include="internal static class DevelopmentRevisionInfo" />
    <_DevelopmentRevisionSource Include="{" />
    <_DevelopmentRevisionSource Include="    internal const string Revision = &quot;$(DevelopmentRevision)&quot;%3B" />
    <_DevelopmentRevisionSource Include="}" />
  </ItemGroup>

  <WriteLinesToFile
    File="$(IntermediateOutputPath)DevelopmentRevisionInfo.g.cs"
    Lines="@(_DevelopmentRevisionSource)"
    Overwrite="true" />

  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)DevelopmentRevisionInfo.g.cs" />
  </ItemGroup>
</Target>
</Project>
