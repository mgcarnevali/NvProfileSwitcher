<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NvProfileSwitcher"
             xmlns:vm="using:NvProfileSwitcher.ViewModels"
             xmlns:b="using:NvProfileSwitcher.Behaviors"
             x:Class="NvProfileSwitcher.Views.ProfileSettingsView"
             x:DataType="vm:ProfileSettingsViewModel">
  <UserControl.Resources>
    <!-- The items of the Refresh rate list: the standard ComboBoxItem theme (its colors and its
         pointer-over, pressed and selected states, which style PART_ContentPresenter), with the
         "Fixed refresh rate" title drawn above the first fixed rate. The title is outside the
         presenter and not hit-testable, and nothing behind it has a background, so it is never
         highlighted, never takes a click and never changes the selection. Only the presenter of
         the Fluent 12.1.2 template is repeated here. -->
    <ControlTheme x:Key="RefreshRateItemTheme" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <!-- The item background (not the dropdown's, which is lighter), so the title area looks
                 like the rest of the list; it stays out of hit testing. -->
            <Border Classes="fixedRatesTitleArea" Background="{TemplateBinding Background}" Padding="11,6,11,4"
                    IsHitTestVisible="False"
                    IsVisible="{CompiledBinding StartsFixedRates, DataType={x:Type local:RefreshRateComboItem}}">
              <StackPanel Classes="fixedRatesTitle" Spacing="4">
                <Separator Margin="0"/>
                <TextBlock Classes="refreshRateHeader" Text="Fixed refresh rate"/>
              </StackPanel>
            </Border>
            <ContentPresenter Name="PART_ContentPresenter"
                              Foreground="{TemplateBinding Foreground}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Padding="{TemplateBinding Padding}"/>
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The Display row, wide (default): labels above, the display selector, Resolution and
         Refresh rate side by side. The cells are set here, not on the controls, so the narrow
         layout below can move them (a local value would win over a style). -->
    <Style Selector="Grid.modeRow > TextBlock.resolutionLabel">
      <Setter Property="Grid.Column" Value="1"/>
    </Style>
    <Style Selector="Grid.modeRow > TextBlock.refreshRateLabel">
      <Setter Property="Grid.Column" Value="2"/>
    </Style>
    <Style Selector="Grid.modeRow > ComboBox.displayCombo">
      <Setter Property="Grid.Row" Value="1"/>
    </Style>
    <Style Selector="Grid.modeRow > ComboBox.resolutionCombo">
      <Setter Property="Grid.Row" Value="1"/>
      <Setter Property="Grid.Column" Value="1"/>
    </Style>
    <Style Selector="Grid.modeRow > ComboBox.refreshRateCombo">
      <Setter Property="Grid.Row" Value="1"/>
      <Setter Property="Grid.Column" Value="2"/>
    </Style>

    <!-- A narrow editor (two-column layouts) moves Resolution and Refresh rate below the display
         selector, which then takes the whole width, so each keeps a usable width. The wide layout
         is unchanged: the rows they use here are empty there and add no space. Declared after the
         default cells, so it wins. Its selectors do not name the container itself: in Avalonia
         12.1.2 a container query styles only the descendants of its container, and a selector
         that includes the container never matches (verified). The classes are the editor's own. -->
    <ContainerQuery Name="modeRow" Query="max-width:529">
      <Style Selector="ComboBox.displayCombo">
        <Setter Property="Grid.ColumnSpan" Value="3"/>
      </Style>
      <Style Selector="TextBlock.resolutionLabel, TextBlock.refreshRateLabel">
        <Setter Property="Grid.Row" Value="2"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
      </Style>
      <Style Selector="ComboBox.resolutionCombo, ComboBox.refreshRateCombo">
        <Setter Property="Grid.Row" Value="3"/>
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <Border Classes="panel">
    <!-- App-specific content and actions measure naturally (Auto);
         the common Display + color section uses the remaining space. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <StackPanel Classes="panelHeader">
        <Viewbox Classes="strokeIcon" Width="18" Height="18">
          <Canvas Width="24" Height="24"><Path Classes="strokeIcon" Data="{StaticResource ProfileSettingsIcon}"/></Canvas>
        </Viewbox>
        <TextBlock Classes="panelTitle" Text="Profile Settings"/>
      </StackPanel>

      <!-- App-only fields are hidden for the fixed Windows profile. -->
      <Grid Grid.Row="1" IsVisible="{CompiledBinding IsApplicationProfile}" Margin="0,7,0,0"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Grid.Row="0" Text="Profile name"/>
        <TextBox Grid.Row="1" Text="{CompiledBinding Name}"/>

        <TextBlock Grid.Row="2" Text="Executable"/>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <ComboBox Classes="executableCombo" HorizontalAlignment="Stretch" PlaceholderText="Select executable"
                    ItemsSource="{CompiledBinding ExecutableItems}" SelectedItem="{CompiledBinding SelectedExecutableItem}">
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="local:ExecutableComboItem">
                <TextBlock Text="{CompiledBinding Text}" TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center"/>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:ExecutableComboItem">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{CompiledBinding Text}" TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center"/>
                  <Button Grid.Column="1"
                          Content="×"
                          Foreground="#E35D6A"
                          IsVisible="{CompiledBinding CanRemove}"
                          Command="{CompiledBinding $parent[ComboBox].((vm:ProfileSettingsViewModel)DataContext).RemoveExecutableCommand}"
                          CommandParameter="{CompiledBinding}"
                          Padding="7,0"
                          MinWidth="0"
                          MinHeight="0"
                          Background="Transparent"
                          BorderThickness="0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Remove executable"/>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Content="Running apps..." VerticalAlignment="Center" Command="{CompiledBinding RunningAppsCommand}"/>
          <Button Grid.Column="2" Content="Browse..." VerticalAlignment="Center" Command="{CompiledBinding BrowseCommand}"/>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="HotkeyField"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Profile hotkey" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Classes="hotkeyField" Classes.capturing="{CompiledBinding IsCapturing}" Focusable="True"
                  HorizontalAlignment="Stretch" DataContext="{CompiledBinding ProfileHotkey}"
                  ToolTip.Tip="Click to change · Press Esc to clear" ToolTip.ShowDelay="400"
                  x:DataType="vm:HotkeyFieldViewModel" b:HotkeyCaptureBehavior.Field="{CompiledBinding}">
            <Grid>
              <TextBlock Text="{CompiledBinding Text}" IsVisible="{CompiledBinding !IsCapturing}" VerticalAlignment="Center"/>
              <Border Classes="hotkeyCaret" IsVisible="{CompiledBinding IsCaretVisible}"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- Common section: identical structure for Windows and application profiles. -->
      <Grid Grid.Row="2" Margin="0,7,0,0" RowDefinitions="Auto,*" RowSpacing="11">
        <!-- Resolution and Refresh rate share the Display row so the color section keeps its
             height; they are shown for application profiles only. Rows 2 and 3 take them when
             the editor is narrow (see the container query above); the spacing is in the margins
             so the empty rows add none. -->
        <Grid Classes="modeRow" Container.Name="modeRow" Container.Sizing="Width"
              RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Viewbox Classes="strokeIcon" Width="18" Height="18">
              <Canvas Width="24" Height="24"><Path Classes="strokeIcon" Data="{StaticResource DisplayIcon}"/></Canvas>
            </Viewbox>
            <TextBlock Text="Display" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Classes="resolutionLabel" Text="Resolution" VerticalAlignment="Center"
                     IsVisible="{CompiledBinding IsApplicationProfile}"/>
          <TextBlock Classes="refreshRateLabel" Text="Refresh rate" VerticalAlignment="Center"
                     IsVisible="{CompiledBinding IsApplicationProfile}"/>
          <ComboBox Classes="displayCombo" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                    ItemsSource="{CompiledBinding Displays}" SelectedItem="{CompiledBinding SelectedDisplay}"
                    ToolTip.Tip="{CompiledBinding SelectedDisplay.SelectorLabel}">
            <!-- The selected display is trimmed with an ellipsis when the row is narrow; the list
                 and the tooltip show the full label. -->
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="local:ConnectedDisplay">
                <TextBlock Text="{CompiledBinding SelectorLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:ConnectedDisplay">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{CompiledBinding IsSelected,
                                            RelativeSource={RelativeSource AncestorType=ComboBoxItem},
                                            DataType={x:Type ComboBoxItem}}"
                            IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center"/>
                  <TextBlock Text="{CompiledBinding SelectorLabel}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Classes="resolutionCombo" Margin="0,6,0,0" Width="140"
                    IsVisible="{CompiledBinding IsApplicationProfile}"
                    ToolTip.Tip="Resolution of this display while the profile is active"
                    ItemsSource="{CompiledBinding ResolutionItems}"
                    SelectedItem="{CompiledBinding SelectedResolutionItem}"
                    IsDropDownOpen="{CompiledBinding IsResolutionListOpen, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:ResolutionComboItem">
                <TextBlock Text="{CompiledBinding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Classes="refreshRateCombo" Margin="0,6,0,0" Width="190"
                    IsVisible="{CompiledBinding IsApplicationProfile}"
                    ToolTip.Tip="Refresh rate of this display while the profile is active"
                    ItemsSource="{CompiledBinding RefreshRateItems}"
                    SelectedItem="{CompiledBinding SelectedRefreshRateItem}"
                    IsDropDownOpen="{CompiledBinding IsRefreshRateListOpen, Mode=TwoWay}"
                    ItemContainerTheme="{StaticResource RefreshRateItemTheme}">
            <!-- The automatic rates first; the fixed rates below the "Fixed refresh rate" title,
                 which the item container theme draws outside the selectable part of the first fixed
                 rate. Every item in the list is a rate: the keyboard and the selection never land on
                 the title. -->
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:RefreshRateComboItem">
                <TextBlock Text="{CompiledBinding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- Equal star rows share the available height; MinHeight keeps rows from overlapping.
             Disabled, not hidden, when the selected display's colors cannot be adjusted. -->
        <Grid Grid.Row="1" ColumnDefinitions="22,Auto,*,Auto" ColumnSpacing="8" Classes="colorControls"
              IsEnabled="{CompiledBinding AreColorsAvailable}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="40"/>
            <RowDefinition Height="*" MinHeight="40"/>
            <RowDefinition Height="*" MinHeight="40"/>
            <RowDefinition Height="*" MinHeight="40"/>
            <RowDefinition Height="*" MinHeight="40"/>
          </Grid.RowDefinitions>

          <Image Grid.Row="0" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 Source="avares://NvProfileSwitcher/Assets/icons/brightness.png"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Center" Text="Brightness"/>
          <Slider Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                  Minimum="80" Maximum="120" Value="{CompiledBinding Brightness}" TickFrequency="1"/>
          <Border Grid.Row="0" Grid.Column="3" Classes="valueBadge"><TextBlock Text="{CompiledBinding BrightnessText}"/></Border>

          <Image Grid.Row="1" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 Source="avares://NvProfileSwitcher/Assets/icons/contrast.png"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Center" Text="Contrast"/>
          <Slider Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                  Minimum="80" Maximum="120" Value="{CompiledBinding Contrast}" TickFrequency="1"/>
          <Border Grid.Row="1" Grid.Column="3" Classes="valueBadge"><TextBlock Text="{CompiledBinding ContrastText}"/></Border>

          <Image Grid.Row="2" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 Source="avares://NvProfileSwitcher/Assets/icons/gamma.png"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Center" Text="Gamma"/>
          <Slider Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                  Minimum="0.3" Maximum="2.8" Value="{CompiledBinding Gamma}" TickFrequency="0.05"/>
          <Border Grid.Row="2" Grid.Column="3" Classes="valueBadge"><TextBlock Text="{CompiledBinding GammaText}"/></Border>

          <Image Grid.Row="3" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 Source="avares://NvProfileSwitcher/Assets/icons/vibrance.png"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Center" Text="Digital vibrance (%)"/>
          <Slider Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                  Minimum="0" Maximum="100" Value="{CompiledBinding Vibrance}" TickFrequency="1"/>
          <Border Grid.Row="3" Grid.Column="3" Classes="valueBadge"><TextBlock Text="{CompiledBinding VibranceText}"/></Border>

          <Image Grid.Row="4" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 Source="avares://NvProfileSwitcher/Assets/icons/hue.png"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Center" Text="Hue"/>
          <Slider Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"
                  Minimum="0" Maximum="359" Value="{CompiledBinding Hue}" TickFrequency="1"/>
          <Border Grid.Row="4" Grid.Column="3" Classes="valueBadge"><TextBlock Text="{CompiledBinding HueText}"/></Border>
        </Grid>
      </Grid>

      <Grid Grid.Row="3" Margin="0,11,0,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Content="Copy settings" Command="{CompiledBinding CopySettingsCommand}"
                IsEnabled="{CompiledBinding AreColorsAvailable}"/>
        <TextBlock Grid.Column="1" Classes="colorsUnavailable" Text="Colors unavailable for this display"
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{CompiledBinding !AreColorsAvailable}"
                   ToolTip.Tip="{CompiledBinding ColorsUnavailableToolTip}"/>
        <Button Grid.Column="2" Content="Reset" ToolTip.Tip="Reset to NVIDIA defaults" ToolTip.ShowDelay="400"
                Command="{CompiledBinding ResetCommand}" IsEnabled="{CompiledBinding AreColorsAvailable}"/>
        <Button Grid.Column="3" Content="Cancel" IsVisible="{CompiledBinding CanCancel}" IsEnabled="{CompiledBinding CanCancel}"
                Command="{CompiledBinding CancelCommand}"/>
        <Button Grid.Column="4" Content="Save profile" Command="{CompiledBinding SaveCommand}"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
