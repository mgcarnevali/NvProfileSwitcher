name: Build UI Prototype

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x64
      - name: Build prototype
        shell: cmd
        run: |
          cl /nologo /std:c++20 /O2 /EHsc /MT /DUNICODE /D_UNICODE /DNOMINMAX NvProfileSwitcher-UI-Prototype.cpp /Fe:NvProfileSwitcher-UI-Prototype.exe /link /SUBSYSTEM:WINDOWS /MACHINE:X64
      - uses: actions/upload-artifact@v4
        with:
          name: NvProfileSwitcher-UI-Prototype
          path: NvProfileSwitcher-UI-Prototype.exe
