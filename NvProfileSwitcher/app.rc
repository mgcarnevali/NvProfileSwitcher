#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APPICON ICON "assets\\branding\\NvProfileSwitcher.ico"
IDR_HEADER_PNG RCDATA "assets\\branding\\header.png"
IDR_SLIDER_BRIGHTNESS RCDATA "assets\\icons\\brightness.png"
IDR_SLIDER_CONTRAST RCDATA "assets\\icons\\contrast.png"
IDR_SLIDER_GAMMA RCDATA "assets\\icons\\gamma.png"
IDR_SLIDER_VIBRANCE RCDATA "assets\\icons\\vibrance.png"
IDR_SLIDER_HUE RCDATA "assets\\icons\\hue.png"
IDR_SECTION_PROFILES RCDATA "assets\\icons\\section-profiles.png"
IDR_SECTION_PROFILE_SETTINGS RCDATA "assets\\icons\\section-profile-settings.png"
IDR_SECTION_APP_SETTINGS RCDATA "assets\\icons\\section-app-settings.png"
IDR_NVIDIA_PNG RCDATA "assets\\icons\\nvidia.png"

1 VERSIONINFO
 FILEVERSION NVPS_VERSION_FILE
 PRODUCTVERSION NVPS_VERSION_FILE
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NvProfileSwitcher\0"
            VALUE "FileDescription", "NvProfileSwitcher\0"
            VALUE "FileVersion", NVPS_VERSION_STR "\0"
            VALUE "InternalName", "NvProfileSwitcher.exe\0"
            VALUE "OriginalFilename", "NvProfileSwitcher.exe\0"
            VALUE "ProductName", "NvProfileSwitcher\0"
            VALUE "ProductVersion", NVPS_VERSION_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

1 24 "app.manifest"
